{
  "name": "londinium-protocol",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-version.mjs",
    "dev": "vite",
    "dev:online": "node scripts/sync-version.mjs && node scripts/dev-online.mjs",
    "dev:server": "node scripts/build-server.mjs --watch",
    "start": "node server/dist/index.mjs",
    "prestart": "node scripts/build-server.mjs",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "release": "npm run build && node scripts/build-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:engine": "node scripts/test-engine.mjs",
    "test:online": "node scripts/build-server.mjs && node scripts/test-online.mjs",
    "test:security": "node scripts/build-server.mjs && node scripts/test-security.mjs",
    "test:local": "node scripts/test-local.mjs",
    "test:release": "node scripts/build-release.mjs && node scripts/test-release.mjs",
    "test:browser": "node scripts/build-server.mjs && node scripts/test-browser.mjs",
    "test:local:browser": "node scripts/build-server.mjs && node scripts/test-local-browser.mjs",
    "test": "npm run test:engine && npm run test:online && npm run test:security && npm run test:local && npm run test:timer && npm run test:hold && npm run test:faction && npm run test:story && npm run test:pact && npm run test:bidprot && npm run test:victory",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "test:timer": "node scripts/test-timer.mjs",
    "test:hold": "node scripts/test-holdlimit.mjs",
    "test:faction": "node scripts/test-faction-deal.mjs",
    "test:story": "node scripts/test-story-bid.mjs",
    "test:pact": "node scripts/test-pact-story.mjs",
    "test:bidprot": "node scripts/test-bid-protection.mjs",
    "test:victory": "node scripts/test-victory-thresholds.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-router-dom": "^6.26.2",
    "ws": "^8.22.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
